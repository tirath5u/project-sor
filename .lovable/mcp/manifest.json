{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "project-sor-mcp",
      "version": "0.3.0",
      "title": "Project SOR: Schedule of Reductions"
    },
    "tools": [
      {
        "name": "calculate_sor",
        "title": "Calculate Schedule of Reductions",
        "description": "Run the source-backed V56 Schedule of Reductions engine. The tool does not use demo defaults for required borrower, enrollment, loan-period, financial, or paid-history facts. If the request is incomplete, it returns exact follow-up questions. When complete, it returns gross and net results, calculation stages, warnings, modeled checks, and public citations.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "awardYear": {
              "type": "string",
              "enum": [
                "2025-26",
                "2026-27"
              ]
            },
            "loanLimitException": {
              "type": "boolean"
            },
            "programLevel": {
              "type": "string",
              "enum": [
                "undergraduate",
                "graduate"
              ]
            },
            "gradeLevel": {
              "type": "string"
            },
            "dependency": {
              "type": "string",
              "enum": [
                "dependent",
                "independent"
              ]
            },
            "parentPlusDenied": {
              "type": "boolean"
            },
            "ayType": {
              "type": "string",
              "enum": [
                "SAY",
                "BBAY1",
                "BBAY2"
              ]
            },
            "calType": {
              "type": "number",
              "enum": [
                1,
                2,
                3,
                4
              ]
            },
            "summerPosition": {
              "type": "string",
              "enum": [
                "none",
                "trailer",
                "header"
              ]
            },
            "loanPeriodScope": {
              "type": "string",
              "enum": [
                "annualMultiTerm",
                "singleTerm"
              ]
            },
            "numStandardTerms": {
              "type": "number",
              "enum": [
                1,
                2,
                3,
                4
              ]
            },
            "includeSummer1": {
              "type": "boolean"
            },
            "includeSummer2": {
              "type": "boolean"
            },
            "includeWinter1": {
              "type": "boolean"
            },
            "includeWinter2": {
              "type": "boolean"
            },
            "ayFtCredits": {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            },
            "annualNeed": {
              "type": "number",
              "minimum": 0
            },
            "subStatutory": {
              "type": "number",
              "minimum": 0
            },
            "unsubStatutory": {
              "type": "number",
              "minimum": 0
            },
            "coa": {
              "type": "number",
              "minimum": 0
            },
            "otherAid": {
              "type": "number",
              "minimum": 0
            },
            "requestedGradPlus": {
              "type": "number",
              "minimum": 0
            },
            "overrideLimits": {
              "type": "boolean"
            },
            "distributionModel": {
              "type": "string",
              "enum": [
                "equal",
                "proportional"
              ]
            },
            "applySubUnsubShift": {
              "type": "boolean"
            },
            "applyDoubleReduction": {
              "type": "boolean"
            },
            "countLthtInAyPct": {
              "type": "boolean"
            },
            "viewMode": {
              "type": "string",
              "enum": [
                "plan",
                "disbursement"
              ]
            },
            "terms": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "enum": [
                      "term1",
                      "term2",
                      "term3",
                      "term4",
                      "summer1",
                      "summer2",
                      "winter1",
                      "winter2"
                    ]
                  },
                  "label": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "ftCredits": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 60
                  },
                  "enrolledCredits": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 60
                  },
                  "disbursed": {
                    "type": "boolean"
                  },
                  "actualCredits": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 60
                  },
                  "paidSub": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "paidUnsub": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "refundSub": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "refundUnsub": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "coaCapSub": {
                    "type": "number",
                    "minimum": 0
                  },
                  "coaCapUnsub": {
                    "type": "number",
                    "minimum": 0
                  },
                  "paidGradPlus": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "refundGradPlus": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "coaCapGradPlus": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              "propertyNames": {
                "enum": [
                  "term1",
                  "term2",
                  "term3",
                  "term4",
                  "summer1",
                  "summer2",
                  "winter1",
                  "winter2"
                ]
              }
            },
            "childTerms": {},
            "feeSubUnsubPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "feeGradPlusPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "traditionalProrationApplies": {
              "type": "boolean"
            },
            "ayDenominatorVerified": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_scenarios",
        "title": "List canonical SOR scenarios",
        "description": "Return the full public parity-fixture set: canonical borrower scenarios, proportional-distribution edge cases, and the V56 child/module allocation fixture, with inputs, expected outputs, and public-source-register citations. Use this to discover valid input shapes for `calculate_sor` or to verify engine parity.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Optional fixture id (e.g. 'fixture-v19-001'). When set, returns only that fixture."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
