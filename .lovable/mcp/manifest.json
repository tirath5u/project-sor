{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "project-sor-mcp",
      "version": "0.6.0",
      "title": "Project SOR: Schedule of Reductions"
    },
    "tools": [
      {
        "name": "calculate_sor",
        "title": "Calculate Schedule of Reductions",
        "description": "Run the source-backed V56 Schedule of Reductions engine. Incomplete requests return exact follow-up questions. Complete results include gross and net outputs, calculation stages, structured policy decisions, stable warnings, modeled inputs, explicit external checks, citations, and release metadata. Inputs the shared engine cannot apply are never silently ignored.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "awardYear": {
              "type": "string",
              "enum": [
                "2025-26",
                "2026-27"
              ]
            },
            "loanLimitException": {
              "type": "boolean"
            },
            "programLevel": {
              "type": "string",
              "enum": [
                "undergraduate",
                "graduate"
              ]
            },
            "gradeLevel": {
              "type": "string"
            },
            "dependency": {
              "type": "string",
              "enum": [
                "dependent",
                "independent"
              ]
            },
            "parentPlusDenied": {
              "type": "boolean"
            },
            "ayType": {
              "type": "string",
              "enum": [
                "SAY",
                "BBAY1",
                "BBAY2"
              ]
            },
            "calType": {
              "type": "number",
              "enum": [
                1,
                2,
                3,
                4
              ]
            },
            "summerPosition": {
              "type": "string",
              "enum": [
                "none",
                "trailer",
                "header"
              ]
            },
            "loanPeriodScope": {
              "type": "string",
              "enum": [
                "annualMultiTerm",
                "singleTerm"
              ]
            },
            "numStandardTerms": {
              "type": "number",
              "enum": [
                1,
                2,
                3,
                4
              ]
            },
            "includeSummer1": {
              "type": "boolean"
            },
            "includeSummer2": {
              "type": "boolean"
            },
            "includeWinter1": {
              "type": "boolean"
            },
            "includeWinter2": {
              "type": "boolean"
            },
            "ayFtCredits": {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            },
            "annualNeed": {
              "type": "number",
              "minimum": 0
            },
            "subStatutory": {
              "type": "number",
              "minimum": 0
            },
            "unsubStatutory": {
              "type": "number",
              "minimum": 0
            },
            "coa": {
              "type": "number",
              "minimum": 0
            },
            "otherAid": {
              "type": "number",
              "minimum": 0
            },
            "requestedGradPlus": {
              "type": "number",
              "minimum": 0
            },
            "overrideLimits": {
              "type": "boolean"
            },
            "distributionModel": {
              "type": "string",
              "enum": [
                "equal",
                "proportional"
              ]
            },
            "applySubUnsubShift": {
              "type": "boolean"
            },
            "applyDoubleReduction": {
              "type": "boolean"
            },
            "countLthtInAyPct": {
              "type": "boolean"
            },
            "viewMode": {
              "type": "string",
              "enum": [
                "plan",
                "disbursement"
              ]
            },
            "terms": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "enum": [
                      "term1",
                      "term2",
                      "term3",
                      "term4",
                      "summer1",
                      "summer2",
                      "winter1",
                      "winter2"
                    ]
                  },
                  "label": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "ftCredits": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 60
                  },
                  "enrolledCredits": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 60
                  },
                  "disbursed": {
                    "type": "boolean"
                  },
                  "actualCredits": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 60
                  },
                  "paidSub": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "paidUnsub": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "refundSub": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "refundUnsub": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "coaCapSub": {
                    "type": "number",
                    "minimum": 0
                  },
                  "coaCapUnsub": {
                    "type": "number",
                    "minimum": 0
                  },
                  "paidGradPlus": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "refundGradPlus": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "coaCapGradPlus": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              "propertyNames": {
                "enum": [
                  "term1",
                  "term2",
                  "term3",
                  "term4",
                  "summer1",
                  "summer2",
                  "winter1",
                  "winter2"
                ]
              }
            },
            "childTerms": {
              "type": "object",
              "additionalProperties": false,
              "required": ["count", "allocationMethod", "parents"],
              "properties": {
                "count": { "type": "integer", "enum": [0, 1, 2, 3, 4] },
                "allocationMethod": { "type": "string", "enum": ["byChildCredits", "equalAcrossActiveChildTerms"] },
                "parents": { "type": "object", "additionalProperties": true }
              }
            },
            "feeSubUnsubPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "feeGradPlusPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "traditionalProrationApplies": {
              "type": "boolean"
            },
            "parentPlusEligibilityBasis": {
              "type": "string",
              "enum": ["none", "adverseCreditDenied", "documentedExceptionalCircumstances", "otherOrUnverified"]
            },
            "parentPlusAggregateUsed": {
              "type": ["number", "null"],
              "minimum": 0
            },
            "traditionalProrationStatus": {
              "type": "string",
              "enum": ["notApplied", "shortProgram", "remainingPeriodShorterThanAcademicYear"]
            },
            "ayDenominatorOverride": {
              "type": ["number", "null"],
              "minimum": 0
            },
            "preSorCaps": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "sub": { "type": ["number", "null"], "minimum": 0 },
                "unsub": { "type": ["number", "null"], "minimum": 0 },
                "gradPlus": { "type": ["number", "null"], "minimum": 0 }
              }
            },
            "requestedSub": { "type": ["number", "null"], "minimum": 0 },
            "requestedUnsub": { "type": ["number", "null"], "minimum": 0 },
            "remainingAnnualSub": { "type": ["number", "null"], "minimum": 0 },
            "remainingAnnualUnsub": { "type": ["number", "null"], "minimum": 0 },
            "remainingAnnualCombined": { "type": ["number", "null"], "minimum": 0 },
            "remainingAggregateSub": { "type": ["number", "null"], "minimum": 0 },
            "remainingAggregateUnsub": { "type": ["number", "null"], "minimum": 0 },
            "remainingAggregateCombined": { "type": ["number", "null"], "minimum": 0 },
            "coaScope": { "type": "string", "enum": ["academicYear", "singleTerm"] },
            "ayDenominatorVerified": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "compare_sor",
        "title": "Compare two SOR scenarios",
        "description": "Run two complete scenarios independently through the shared V56 engine and return numeric deltas, warning changes, authoritative status, and calculation results. This tool is stateless and does not save student or scenario payloads.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "required": ["left", "right"],
          "properties": {
            "left": { "type": "object", "additionalProperties": true },
            "right": { "type": "object", "additionalProperties": true }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "advanced_student_estimate",
        "title": "Run an advanced student estimate",
        "description": "Run a complete institution-specific V2 scenario through the shared engine and return a student-readable gross estimate with stages, warnings, and external checks. This is decision support, not an award, and it is stateless.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "required": ["input"],
          "properties": {
            "input": { "type": "object", "additionalProperties": true },
            "resultDetail": { "type": "string", "enum": ["summary", "detailed"] }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "compare_sor_versions",
        "title": "Compare approved V55 and V56 results",
        "description": "Compare an approved V55 baseline fixture with the current V56 engine. This is a read-only migration aid for approved fixtures only, not a general historical calculator.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "required": ["fixtureId"],
          "properties": {
            "fixtureId": {
              "type": "string",
              "enum": ["fixture-v19-007"]
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_scenarios",
        "title": "List canonical SOR scenarios",
        "description": "Return the full public parity-fixture set: canonical borrower scenarios, proportional-distribution edge cases, and the V56 child/module allocation fixture, with inputs, expected outputs, and public-source-register citations. Use this to discover valid input shapes for `calculate_sor` or to verify engine parity.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Optional fixture id (e.g. 'fixture-v19-001'). When set, returns only that fixture."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
